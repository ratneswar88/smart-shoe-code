class TrainingPage extends StatefulWidget {
  const TrainingPage({super.key, required this.ble});
  final ShoeBle ble;

  @override
  State<TrainingPage> createState() => _TrainingPageState();
}



  // --- GPS/Internet helpers (auto-inserted) ---
  StreamSubscription<Position>? _posSub;

  Future<bool> _ensureLocationAndInternet(BuildContext context) async {
    // Location service
    bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
    if (!serviceEnabled) {
      final go = await _prompt(context,
        'Turn on Location',
        'Please enable Location (GPS) to capture the route.',
        actionLabel: 'Open Settings',
        action: () async { await Geolocator.openLocationSettings(); });
      if (!go) return false;
      serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) return false;
    }
    // Permission
    LocationPermission permission = await Geolocator.checkPermission();
    if (permission == LocationPermission.denied) {
      permission = await Geolocator.requestPermission();
    }
    if (permission == LocationPermission.deniedForever ||
        permission == LocationPermission.denied) {
      await _prompt(context,
        'Location permission',
        'Grant location permission to record the route.',
        actionLabel: 'App Settings',
        action: () async { await Geolocator.openAppSettings(); });
      return false;
    }

    // Internet check (tiles)
    final conn = await Connectivity().checkConnectivity();
    if (conn == ConnectivityResult.none) {
      await _prompt(context,
        'Turn on Internet',
        'Map tiles need Wiâ€‘Fi or Mobile Data. You can still record the route offline.',
        actionLabel: 'Open Wiâ€‘Fi',
        action: () async { await Geolocator.openAppSettings(); });
    }
    return true;
  }

  Future<void> _startGpsStream() async {
    await _posSub?.cancel();
    const settings = LocationSettings(
      accuracy: LocationAccuracy.best,
      distanceFilter: 1,
    );
    _posSub = Geolocator.getPositionStream(locationSettings: settings).listen((p) {
      if (!mounted) return;
      if (!_isCapturing) return;
      final ll = LatLng(p.latitude, p.longitude);
      if (_track.isEmpty || _track.last.latitude != ll.latitude || _track.last.longitude != ll.longitude) {
        setState(() {
          _track.add(ll);
          final n = _track.length;
          if (n > 1) {
            _distanceMeters += Geolocator.distanceBetween(
              _track[n-2].latitude, _track[n-2].longitude,
              ll.latitude, ll.longitude);
          }
        });
      }
    });
  }

