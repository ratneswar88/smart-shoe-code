    _s8 = widget.ble.stride$.stream.listen((v) => setState(() => stride = v));
    _s9 = widget.ble.dh$.stream.listen((v) => setState(() => dh = v));
    _s10 = widget.ble.rssi$.listen((v) => setState(() => rssi = v));
