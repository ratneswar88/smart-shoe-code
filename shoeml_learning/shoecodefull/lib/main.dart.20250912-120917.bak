  @override
  State<TrainingPage> createState() => _TrainingPageState();
}

class _TrainingPageState extends State<TrainingPage> {

Future<List<_SessionFile>> _listSessions() async {
  try {
    final app = await _appDir();
    final base = await _ensureDir(app, 'ShoeML');
    final dir = await _ensureDir(base, 'sessions');
    final entries = await dir
        .list()
        .where((e) => e is File && e.path.toLowerCase().endsWith('.csv'))
        .cast<File>()
        .toList();

    final out = <_SessionFile>[];
    for (final f in entries) {
      final m = await f.lastModified();
      out.add(_SessionFile(f, m));
    }
    out.sort((a, b) => b.modified.compareTo(a.modified));
    return out;
  } catch (_) {
    return [];
  }
}


  final _labels = [
    "walking",
    "running",
    "stairs_up",
    "stairs_down",
    "standing",
    "sitting"
  ];
